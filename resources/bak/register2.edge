          isRequired: true,
          enableFloatingLabel: false,
          cstmAutogrowHeight: true,
          cstmAutogrowHeightMinPx: 100,
          errorMessage: form?.errors?.full_home_address || ''
        })
        @end
      </div>

      <div class="col-12 col-md-6">
        @!component('components/input/input', {
          id: 'phone',
          name: 'personal_phone_number',
          labelText: 'Phone Number',
          labelIcon: 'telephone',
          labelIconIsFill: false,
          type: 'number',
          isRequired: true,
          inputStyle: 'number-input-no-arrow',
          value: form?.values?.personal_phone_number || '',
          placeholder: '012345678910',
          errorMessage: form?.errors?.personal_phone_number || ''
        })
      </div>
        
      <div class="col-12 col-md-6">
        @component('components/input/input', {
          id: 'email',
          name: 'email',
          labelText: 'Email',
          labelIcon: 'envelope',
          labelIconIsFill: false,
          type: 'email',
          value: form?.values?.email || '',
          placeholder: 'email@example.com',
          isRequired: true,
          enableFloatingLabel: false,
          autocomplete: 'email',
          helpText: 'This email will be used as login credential',
          errorMessage: form?.errors?.email || ''
        })
        @end
      </div>
      
      <div class="col-12 col-md-6">
        @component('components/input/input', {
          type: 'password',
          id: 'passwordInput',
          name: 'password',
          labelText: 'Password',
          labelIcon: 'key',
          labelIconIsFill: false,
          value: form?.values?.password || '',
          isRequired: true,
          autocomplete: 'new-password',
          enableFloatingLabel: false,
          placeholder: 'Password',
          cstmDataTogglePassword: 'password',
          helpText: 'Password must consist of minimum 8 character',
          errorMessage: form?.errors?.password || ''
        })
          @slot('suffix')
            @!component('components/button/button', {
              style: 'input-group-text',
              variant: 'secondary',
              isOutline: true,
              type: 'button',
              text: 'Show',
              iconName: 'eye',
              textAlt: 'Hide',
              iconNameAlt: 'eye-slash',
              cstmDataTogglePasswordBtn: 'password'
            })
          @end
        @end
      </div>
      
      <div class="col-12 col-md-6">
        @component('components/input/input', {
          type: 'password',
          id: 'confirmPasswordInput',
          name: 'password_confirmation',
          labelText: 'Confirm Password',
          labelIcon: 'key',
          labelIconIsFill: false,
          value: form?.values?.password || '',
          isRequired: true,
          autocomplete: 'new-password',
          enableFloatingLabel: false,
          placeholder: 'Password',
          cstmDataTogglePassword: 'confirmPasswordInput',
          helpText: 'Password confirmation must match "Password" input',
          errorMessage: form?.errors?.password_confirmation || ''
        })
          @slot('suffix')
            @!component('components/button/button', {
              style: 'input-group-text',
              variant: 'secondary',
              isOutline: true,
              type: 'button',
              text: 'Show',
              iconName: 'eye',
              textAlt: 'Hide',
              iconNameAlt: 'eye-slash',
              cstmDataTogglePasswordBtn: 'confirmPasswordInput'
            })
          @end
        @end
      </div>
      
      <div class="col-12">
        @!component('components/button/button', {
          style: 'mt-3 w-100',
          type: 'submit',
          text: 'Register',
          enableLoadingIndicator: true
        })
      </div>
    </form>
  @else
    <form hx-get="{{ route('auth.register.create') }}" hx-target="this" hx-swap="outerHTML" class="row g-3 mt-1">

      <div class="col-12">
        @!component('components/input/split', {
          id: 'registerCode',
          name: 'register_code',
          labelText: 'Register Code',
          labelIcon: 'asterisk',
          labelIconIsFill: false,
          placeholder: 'Abc123',
          isRequired: true,
          fieldCount: G_REGISTER_CODE_LENGTH,
          helpText: 'Request an register code/invite link from an admin or registered employee',
          value: form?.values?.register_code || '',
          errorMessage: form?.errors?.register_code || '',
        })
      </div>
      
      <div class="col-12">
        @!component('components/button/button', {
          style: 'mt-3 w-100',
          type: 'submit',
          text: 'Verify',
          loadingIndicatorText: 'Verifying...',
          enableLoadingIndicator: true
        })
      </div>
    </form>
  @endif
@end

