@if(isHtmx)
  @if(form?.values?.register_code && isRegisterCodeValid)
    <form hx-post="{{ route('auth.register.store') }}" hx-target="this" hx-swap="outerHTML" class="row g-3 mt-1">
      {{ csrfField() }}

      <div class="col-12">
        @!component('components/input/split', {
          id: 'registerCode',
          name: 'register_code',
          labelText: 'Register Code',
          labelIcon: 'asterisk',
          labelIconIsFill: false,
          placeholder: 'Abc123',
          isRequired: true,
          isReadOnly: isRegisterCodeValid ? true : false,
          fieldCount: G_REGISTER_CODE_LENGTH,
          helpText: 'This register code can only be used once (invalid after successful registration)',
          value: form?.values?.register_code || '',
          errorMessage: form?.errors?.register_code || '',
        })
      </div>
      
      <div class="col-12">
        @component('components/input/input', {
          id: 'fullName',
          name: 'full_name',
          labelText: 'Full Name',
          labelIcon: 'person',
          value: form?.values?.full_name || '',
          placeholder: 'First middle last name',
          isRequired: true,
          enableFloatingLabel: false,
          errorMessage: form?.errors?.full_name || ''
        })
        @end
      </div>

      <div class="col-12">
        @!component('components/input/select', {
          id: 'personTitleName',
          name: 'person_title_name_ids[]',
          labelText: 'Academic Title',
          labelIcon: 'mortarboard',
          placeholder: "Select academic titles",
          isRequired: true,
          enableFloatingLabel: false,
          enableTomSelect: true,
          options: personTitleNameOptions || [],
          queryEndpoint: route('api.personTitleName.search'),
          queryEndpointMethod: 'GET',
          tomSelectPlugins: 'dropdown_input;remove_button;',
          tomSelectOptionValueField: 'value',
          tomSelectOptionLabelField: 'label',
          tomSelectOptionSearchField: 'label',
          tomSelectOptionPreload: 'true',
          tomSelectOptionMaxItems: 10,
          helpText: 'Able to select more than one academic title',
          errorMessage: form?.errors?.person_title_name_ids || ''
        })
      </div>

      <div class="col-12">
        @!component('components/input/select', {
          id: 'gender',
          name: 'gender_id',
          labelText: 'Gender',
          labelIcon: 'gender-ambiguous',
          placeholder: "Select gender",
          isRequired: true,
          enableFloatingLabel: false,
          enableTomSelect: true,
          options: genderOptions || [],
          queryEndpoint: route('api.gender.search'),
          queryEndpointMethod: 'GET',
          tomSelectOptionValueField: 'value',
          tomSelectOptionLabelField: 'label',
          tomSelectOptionSearchField: 'label',
          tomSelectOptionPreload: 'true',
          errorMessage: form?.errors?.gender || '',
        })
      </div>

      <div class="col-12 col-md-6">
        @!component('components/input/input', {
          id: 'birthDate',
          name: 'birth_date',
          labelText: 'Date of Birth',
          labelIcon: 'calendar',
          labelIconIsFill: false,
          type: 'date',
          isRequired: true,
          value: form?.values?.birth_date || '',
          placeholder: '12/31/2004',
          enableFloatingLabel: false,
          errorMessage: form?.errors?.birth_date || ''
        })
      </div>

      <div class="col-12 col-md-6">
        @component('components/input/input', {
          id: 'birthPlace',
          name: 'birth_place',
          labelText: 'Place of Birth',
          labelIcon: 'geo-alt',
          labelIconIsFill: false,
          value: form?.values?.birth_place || '',
          placeholder: 'Region or province or city',
          isRequired: true,
          enableFloatingLabel: false,
          errorMessage: form?.errors?.birth_place || ''
        })
        @end
      </div>

      <div class="col-12">
        @component('components/input/textarea', {
          id: 'fullHomeAddress',
          name: 'full_home_address',
          labelText: 'Home Address',
          labelIcon: 'house-door',
          labelIconIsFill: false,
          type: 'text',
          value: form?.values?.full_home_address || '',
