@layout({ title: 'Register Account', pageDescription: 'Register Account', bodyStyle: 'd-flex flex-column vh-100 overflow-hidden'})
  @slot('head')
    @vite(['resources/css/pages/register.scss', 'resources/js/utils/input_actions.js'])
  @endslot

  @slot('main')
    {{-- 
      Added 'flex-grow-1' so this row fills all available space between top and footer.
      Added 'overflow-hidden' to prevent the row itself from scrolling the body.
    --}}
    <div class="row g-0 flex-grow-1 overflow-hidden">
      
      {{-- 
         Added 'h-100' to the column. 
      --}}
      <div class="col-12 col-lg-4 d-none d-lg-flex h-100">
        <img 
          src="{{ asset('public/images/gedung_graha_sewaka_dharma_lumintang.jpg') }}" 
          alt="Login Cover" 
          {{-- Added 'h-100 w-100' so the image fills the column completely --}}
          class="img-fluid h-100 w-100"
          style="object-fit: cover;"
        />
      </div>

      {{-- 
         Added 'h-100' to fill height.
         Added 'overflow-y-auto' -> THIS is what makes only this column scroll.
      --}}
      <div class="col-12 col-lg-8 d-flex flex-column h-100 overflow-y-auto">
        <div class="p-4 p-4 p-md-5 container-xxl my-auto">
          <img
            class="img-fluid logo-pic-size-large"
            src="{{ asset('public/images/logo_diskominfos_denpasar_small.png') }}"
            alt="App Logo"
            style="object-fit: cover;"
          />
          <h1 class="h3 mt-3 mb-0 mt-3">Register</h1>
          <p class="text-muted mt-2 mb-0">Let's make an account for you</p>

          @if(registerCodeValue) 
            @!component('components/form/register', {
              registerCodeValue: registerCodeValue,
              registerCodeErrorMessage: registerCodeErrorMessage,
              fullNameValue: fullNameValue,
              fullNameErrorMessage: fullNameErrorMessage,
              personTitleNameValue: personTitleNameValue,
              personTitleNameErrorMessage: personTitleNameErrorMessage,
              genderValue: genderValue,
              genderErrorMessage: genderErrorMessage,
              birthDateValue: birthDateValue,
              birthDateErrorMessage: birthDateErrorMessage,
              birthPlaceValue: birthPlaceValue,
              birthPlaceErrorMessage: birthPlaceErrorMessage,
              fullHomeAddressValue: fullHomeAddressValue,
              fullHomeAddressErrorMessage: fullHomeAddressErrorMessage,
              personalPhoneNumberValue: personalPhoneNumberValue,
              personalPhoneNumberErrorMessage: personalPhoneNumberErrorMessage,
              emailValue: emailValue,
              emailErrorMessage: emailErrorMessage,
              passwordValue: passwordValue,
              passwordErrorMessage: passwordErrorMessage,
              passwordConfirmationValue: passwordConfirmationValue,
              passwordConfirmationErrorMessage: passwordConfirmationErrorMessage
            }) 
          @else
            @!component('components/form/verify_register_code', {
              registerCodeValue: registerCodeValue,
              registerCodeErrorMessage: registerCodeErrorMessage,
              emailValue: emailValue,
              emailErrorMessage: emailErrorMessage
            })
          @end

          <p class="mt-4 mb-0 text-body-secondary">
            Already have an account? <a href="{{ route('auth.login.create') }}" class="link-primary">Login here</a>
          </p>
        </div>
      </div>
    </div>
    
    {{-- Footer is outside the scrollable area, so it stays fixed at bottom --}}
    @!footer({})
  @endslot
@end
