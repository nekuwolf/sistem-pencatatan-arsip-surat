@layout.dashboard({ pageTitle: 'User Data Dashboard' })
  @slot('head')
    @vite(['resources/css/components/profile_picture.scss', 'resources/js/components/profile_picture.js', 'resources/js/utils/input_actions.js'])
  @endslot

  @slot('main')
    @!component('components/dashboard/breadcrumb', {
      items: [
        { label: 'User Data', iconName: 'people'},
      ]
    })
    <h4 class="fs-4 mb-0">User Data</h4>

    {{-- Check if we have data AND if that data array is not empty --}}
    @if(userTableDatas && userTableDatas.datas.length > 0)

      {{-- 1. Render Desktop Table --}}
      @!component('components/data_display/table_desktop', { 
        columns: userTableDatas.columns, 
        datas: userTableDatas.datas, 
        style: 'mt-3' 
      })

      {{-- 2. Render Mobile List --}}
      @!component('components/data_display/mobile_list', { 
        columns: userTableDatas.columns, 
        datas: userTableDatas.datas, 
        style: 'mt-3' 
      })

      {{-- 3. Render Pagination --}}
      <div class="d-flex justify-content-center mt-4">
        @!component('components/pagination', { paginator: paginator })
      </div>

    @else
      
      {{-- 4. Empty State --}}
      <div class="alert alert-light text-center mt-3 p-5 shadow-sm" role="alert">
        @!component('components/bi_icon', { 
          style: 'text-muted fs-1',
          iconName: 'inbox',
          isFill: false,
        })
        <h4 class="mt-3 text-muted">No data available</h4>
        <p class="text-secondary mb-0">It looks like there are no users to display right now.</p>
      </div>

    @end
    
  @endslot
@end