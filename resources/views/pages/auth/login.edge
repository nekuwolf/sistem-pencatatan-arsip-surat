@layout({ title: 'Account Login', pageDescription: 'Account Login', bodyStyle: 'd-flex flex-column vh-100 overflow-hidden'})
  @slot('main')
    <div class="row g-0 flex-grow-1 overflow-hidden">

      {{-- big left side pict --}}
      <div class="col-12 col-lg-4 d-none d-lg-flex h-100">
        <img 
          src="/images/gedung_graha_sewaka_dharma_lumintang.jpg" 
          alt="Login Cover" 
          {{-- Added 'h-100 w-100' so the image fills the column completely --}}
          class="img-fluid h-100 w-100"
          style="object-fit: cover;"
        />
      </div>

      {{-- login form --}}
      <div class="col-12 col-lg-8 d-flex flex-column h-100 overflow-y-auto">
        <div class="p-4 p-md-5 container-xxl my-auto">
          <img
            class="img-fluid logo-pic-size-large"
            src="/images/logo_diskominfos_denpasar_small.png"
            alt="App Logo"
            style="object-fit: cover;"
          />
          <h1 class="h3 mt-3 mb-0 mt-3">Login</h1>
          <p class="text-muted mt-2 mb-0">Welcome, please login to access the system</p>

          <form method="POST" action="{{ route('auth.login.store') }}" class="row g-3 mt-1">
            {{ csrfField() }}
            
            {{-- 1. Handle General Error (Invalid Credentials) --}}
            @if(flashMessages.has('loginFormErrorMessage'))
              <div class="col-12">
                @!component('components/alert', { 
                  variant: 'warning', 
                  message: flashMessages.get('loginFormErrorMessage') 
                })
              </div>
            @end
            
            {{-- 2. Email Input --}}
            <div class="col-12">
              @component('components/input/input', {
                id: 'email',
                name: 'email',
                labelText: 'Email',
                labelIcon: 'envelope',
                labelIconIsFill: false,
                type: 'email',
                // 'old' retrieves the value from the previous request 
                value: old('email') || '', 
                placeholder: 'example@company.com',
                isRequired: true,
                enableFloatingLabel: true,
                autocomplete: 'email',
                // 'flashMessages.get' retrieves validation errors for specific field
                errorMessage: flashMessages.get('errors.email') || ''
              })
              @end
            </div>

            {{-- 3. Password Input --}}
            <div class="col-12">
              @component('components/input/input', {
                type: 'password',
                id: 'passwordInput',
                name: 'password',
                labelText: 'Password',
                labelIcon: 'key',
                labelIconIsFill: false,
                // Best Practice: Do not use old() for passwords (security risk)
                value: '', 
                isRequired: true,
                autocomplete: 'current-password',
                enableFloatingLabel: true,
                placeholder: 'supersecurepassword',
                cstmDataTogglePassword: 'password',
                errorMessage: flashMessages.get('errors.password') || ''
              })
                @slot('suffix')
                  @!component('components/button/button', {
                    style: 'input-group-text',
                    variant: 'secondary',
                    isOutline: true,
                    type: 'button',
                    text: 'Show',
                    iconName: 'eye',
                    textAlt: 'Hide',
                    iconNameAlt: 'eye-slash',
                    cstmDataTogglePasswordBtn: 'password'
                  })
                @end
              @end
            </div>
            
            <div class="col-12">
              @!component('components/button/button', {
                style: 'mt-3 w-100',
                type: 'submit',
                text: 'Login',
                loadingIndicatorText: 'Logging in...',
                enableLoadingIndicator: true
              })
            </div>
          </form>

          <p class="mt-4 mb-0 text-body-secondary">
            Didn't have an account? <a href="{{ route('auth.register.create') }}" class="link-primary">Register here</a>
          </p>
        </div>
      </div>
    </div>
    
    {{-- Footer is outside the scrollable area, so it stays fixed at bottom --}}
    @!footer({})
  @endslot
@end