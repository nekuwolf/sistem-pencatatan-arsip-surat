        <!-- Image Placeholder: Updated to use light text on dark primary color for dark mode -->
        <img
          class="mb-4 rounded-circle"
          src="{{ asset('public/images/valve_source_engine_missing_content_512_512.png') }}"
          alt="App Logo"
          width="72"
          height="72"
        />
        
        <!-- Text colors are handled automatically by data-bs-theme="dark" -->
        <h1 class="h3 mb-3 fw-normal">Register</h1>
        <p class="text-muted mb-0">Let's make an account for you</p>
        
        @!component('components/form/verify_register_code', {
