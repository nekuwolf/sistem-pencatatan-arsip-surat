<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ bsTheme || 'auto' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ pageTitle || 'Default Title' }}</title>
  <meta name="description" content="{{ pageDescription || pageTitle || 'Default Description' }}">
  @if ($slots.head)
    {{{ await $slots.head() }}}
  @endif
  @vite(['resources/js/app.js', 'resources/js/components/profile_picture.js', 'resources/css/components/profile_picture.scss', 'resources/css/app.scss', 'resources/css/pages/dashboard.scss', 'resources/js/components/sidebar.js'])
</head>
<body {{
  html.attrs({
    class: [
      bodyStyle,
      (request.plainCookie('sidebarCollapsed') === 'true' ? 'sidebar-collapsed' : '')
    ]
  })
}}>
  @!component('components/dashboard/sidebar')
  <div class="sidebar-backdrop d-lg-none"></div>
  <div class="main-content">
    @!component('components/dashboard/topbar')
    <main class="container-fluid {{ mainStyle || 'p-3' }}">
      {{-- Flash Message Listener --}}
      <div class="flash-messages">
        @if(flashMessages.has('notification'))
          @let(notification = flashMessages.get('notification'))
          @!component('components/alert', { 
            variant: notification.type, 
            message: notification.message,
            isDismissible: true 
          })
        @end

        {{-- Catch-all for basic error/success keys --}}
        @if(flashMessages.has('success'))
          @!component('components/alert', { 
            variant: 'success', 
            message: flashMessages.get('success'),
            isDismissible: true 
          })
        @end

        @if(flashMessages.has('errorsBag'))
          @!component('components/alert', { 
            variant: 'danger', 
            message: 'There were some issues with your submission.',
            isDismissible: true 
          })
        @end
      </div>

      @if($slots.main)
        {{{ await $slots.main() }}}
      @end
    </main>
    @!component('components/footer')
  </div>

  <!-- Modal 1: Image Preview / Selection -->
  {{-- <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0">
          <h5 class="modal-title fs-5">Profile Photo</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center pb-3">
          <div class="modal-profile-preview" id="modalProfileContainer">
            <!-- Initials & fallback -->
            <img id="modalImage" class="w-100 h-100 object-fit-cover d-none" alt="Modal Preview">
