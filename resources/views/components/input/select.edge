@let(inputId = id || name)
@let(errorId = `${inputId}Feedback`)
@let(helpId = `${inputId}Help`)
@let(isThereOptionSelected = false)
@let(_tomSelectOptionMaxItems = tomSelectOptionMaxItems || 1)

{{-- Determine if error exists in Flash Messages (Adonis standard) or manual prop --}}
@let(_errorMessage = flashMessages.get(`errors.${name}`) || errorMessage || '')
@let(hasError = _errorMessage ? true : false)

@if(labelText && !enableFloatingLabel)
  @if(labelText)
    <label for="{{ inputId }}" class="form-label">
      @if(labelIcon)
        @!component('components/bi_icon', { iconName: labelIcon, isFill: labelIconIsFill })
      @end
      {{ labelText }}
    </label>
  @end
@end

{{-- Outer Wrapper: Logic to switch between standard spacing and input-group --}}
@if($slots.prefix || $slots.suffix)
  <div {{
    html.attrs({
      class: [
        inputGroupStyle,
        'input-group'
      ]
    })
  }}>
@end
  
  {{-- 1. Prefix Slot (Left) --}}
  @if($slots.prefix)
    {{{ await $slots.prefix() }}}
  @end

  {{-- 2. Input & Label Area --}}
  @if(enableFloatingLabel)
    {{-- Floating Label Structure --}}
    <div {{
      html.attrs({
        class: [
          'form-floating',
          floatingWrapperStyle
        ]
      })
    }}>
  @end

  <select {{
    html.attrs({
      id: inputId,
      name: name,
      type: type || 'text',
      'aria-describedby': `${hasError ? errorId : ''} ${help ? helpId : ''}`.trim(),
      'hidden': isHidden,
      'disabled': isDisabled,
      'required': isRequired,
      'cstm-data-query-endpoint': queryEndpoint,
      'cstm-data-query-endpoint-method': queryEndpointMethod,
      'data-tom-select': enableTomSelect ? 'true' : 'false',
      'data-tom-select-only-search-locally': tomSelectOnlySearchLocally ? 'true' : 'false',
      'data-ts-plugins': tomSelectPlugins,
      'data-tso-value-field': tomSelectOptionValueField,
      'data-tso-label-field': tomSelectOptionLabelField,
      'data-tso-search-field': tomSelectOptionSearchField,
      'data-tso-placeholder': tomSelectOptionPlaceholder || placeholder,
      'data-tso-max-items': _tomSelectOptionMaxItems,
      'data-tso-hide-selected': tomSelectOptionHideSelected,
      'data-tso-close-after-select': tomSelectOptionCloseAfterSelect || _tomSelectOptionMaxItems < 2 ? 'true' : 'false',
      'data-tso-copy-classes-to-dropdows': tomSelectOptionCopyClassesToDropdown,
      'data-tso-allow-empty-option': tomSelectOptionAllowEmptyOption,
      'data-tso-preload': tomSelectOptionPreload,
      class: [
        'form-select',
        {
          'is-invalid': hasError,
          'd-none': isHidden,
        },
        inputStyle
      ]
    })
  }}>
    
    @if(options)
      @each(option in options)
        @if(!isThereOptionSelected)
          @assign(isThereOptionSelected = option.isSelected ? true : false)
        @end
        <option {{
          html.attrs({
            value: option.value,
            'selected': option.isSelected,
          })
        }}>{{ option.label }}</option>
      @endeach
    @end

    @if(placeholder && !enableTomSelect)
      <option value="" {{
        html.attrs({
          disabled: true,
          selected: isThereOptionSelected ? false : _tomSelectOptionMaxItems > 1 ? false : true,
          hidden: isThereOptionSelected ? false : true,
        })
      }}>{{ placeholder }}</option>
    @endif
  </select>

  @if(enableFloatingLabel)
    <label for="{{ inputId }}">
      @if(labelIcon)
        @!component('components/bi_icon', { iconName: labelIcon, isFill: labelIconIsFill })
      @end
      {{ labelText }}
    </label>
    </div>
  @end

  {{-- 3. Suffix Slot (Right) --}}
  @if($slots.suffix)
    {{{ await $slots.suffix() }}}
  @end

  {{-- 4. Validation Feedback --}}
  @if(_errorMessage)
    <div id="{{ errorId }}" class="invalid-feedback d-flex align-items-start text-start">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      {{ _errorMessage }}
    </div>
  @end

@if($slots.prefix || $slots.suffix)
  </div>
@end

{{-- 5. Help Text (Always outside the input-group to prevent breaking layout) --}}
@if(helpText)
  <div id="{{ helpId }}" class="form-text d-flex align-items-start text-start mt-1">
    <i class="bi bi-info-circle-fill me-2"></i>
    {{ helpText }}
  </div>
@end